# Normalise line endings so a Windows contributor doesn't reformat whole files.
* text=auto eol=lf

*.png binary
*.ico binary
*.zip binary
*.svg text

# Vendored builds: collapsed in diffs and kept out of the language statistics.
app/vendor/**             linguist-vendored
public/assets/vendor/**   linguist-vendored

# Kept out of GitHub's "Source code" archives (made with `git archive`, which
# honours this attribute). That archive IS the download (CONTRIBUTING.md §
# Cutting a release), so this list decides what users get: the site and
# nothing else. Everything here stays in the repository.
#
# NOT listed here, and never to be: public/, app/,
# config-sample.php, projects-sample.php, .htaccess, LICENSE.
# bin/lint.sh checks the result.
.github/          export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore
.editorconfig     export-ignore
docs/             export-ignore
bin/              export-ignore
/README.md        export-ignore
/CHANGELOG.md     export-ignore
/CONTRIBUTING.md  export-ignore
/SECURITY.md      export-ignore
